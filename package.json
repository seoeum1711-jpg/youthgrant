{
  "name": "youthgrant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run unit",
    "typecheck": "tsc --noEmit",
    "unit": "node --experimental-strip-types --test tests/domain.test.ts tests/collectors.test.ts tests/attachments.test.ts tests/review.test.ts tests/security.test.ts tests/relevance.test.ts",
    "rendered": "node --test tests/rendered-html.test.mjs",
    "lint": "eslint app lib db worker tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "deploy:preview": "node scripts/cloudflare-deploy.mjs preview",
    "deploy:production": "node scripts/cloudflare-deploy.mjs production"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
